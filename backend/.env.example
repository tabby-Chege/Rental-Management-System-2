DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/rental_management
JWT_SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
REQUIRE_TWO_FACTOR=true
TOTP_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
# SMS codes require a Twilio account; leave unset to disable SMS verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set these to the public HTTPS origin and host in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Property Finder
WEBAUTHN_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANT_PII_ENCRYPTION_KEY=
# Local storage is used when no S3 bucket is configured. For production,
# set OBJECT_STORAGE_BACKEND=s3, configure S3_BUCKET, and provide AWS credentials.
OBJECT_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=
S3_BUCKET=
S3_REGION=us-east-1
# Optional for S3-compatible services such as MinIO.
S3_ENDPOINT_URL=
S3_SERVER_SIDE_ENCRYPTION=AES256
# Use the AWS credential chain or inject credentials through the deployment secret store.

# Payment providers default to sandbox. Configure each provider with live credentials
# only in the deployment secret store; unset providers remain unavailable.
PAYMENT_ENVIRONMENT=sandbox
FRONTEND_BASE_URL=http://localhost:5173
BANK_TRANSFER_INSTRUCTIONS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=
PESAPAL_IPN_ID=

# Email is delivered by the process-email-outbox scheduled command.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
# Set true only in tests or local development to mark outbox email as sent without sending.
MAIL_SUPPRESS_SEND=false
